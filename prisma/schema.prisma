// DevPath.hub database schema (Prisma 7 + PostgreSQL).
//
// Prisma 7 uses the `prisma-client` generator with an explicit output path,
// and generates an ESM client you import from that path (see lib/prisma.ts).
// To target the spec's MySQL in production: change provider to "mysql", swap
// the `String[]` array fields (Postgres-only) for a join table or JSON, and run
// a fresh migration.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum UserRole {
  USER
  ADMIN
  MENTOR
}

// --- Content -------------------------------------------------------------

model Tech {
  id            String        @id @default(uuid())
  name          String        @unique
  slug          String        @unique
  description   String
  tagline       String
  iconEmoji     String
  color         String
  isFeatured    Boolean       @default(false)
  statsLearners String
  statsGuides   Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  setupGuide    SetupGuide?
  roadmaps      Roadmap[]
  projects      Project[]
  errors        CommonError[]
  tools         Tool[]
  challenges    Challenge[]
  certificates  Certificate[]
}

model SetupGuide {
  id          String      @id @default(uuid())
  techId      String      @unique
  tech        Tech        @relation(fields: [techId], references: [id], onDelete: Cascade)
  title       String
  description String
  steps       SetupStep[]
}

model SetupStep {
  id           String     @id @default(uuid())
  guideId      String
  guide        SetupGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  title        String
  command      String?
  explanation  String
  why          String
  alternatives String?
  verification String?
  eli5         String?
  order        Int
}

model Roadmap {
  id           String         @id @default(uuid())
  techId       String
  tech         Tech           @relation(fields: [techId], references: [id], onDelete: Cascade)
  title        String
  description  String
  level        Level          @default(BEGINNER)
  order        Int            @default(0)
  steps        RoadmapStep[]
  userProgress UserProgress[]
  bookmarks    Bookmark[]
}

model RoadmapStep {
  id            String         @id @default(uuid())
  roadmapId     String
  roadmap       Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  title         String
  content       String
  eli5Content   String?
  codeSnippet   String?
  playgroundUrl String?
  order         Int
  userProgress  UserProgress[]
}

model Project {
  id             String        @id @default(uuid())
  techId         String
  tech           Tech          @relation(fields: [techId], references: [id], onDelete: Cascade)
  slug           String
  title          String
  description    String
  level          Level         @default(BEGINNER)
  starterCode    String?
  demoUrl        String?
  estimatedHours Int           @default(0)
  tags           String[]
  steps          ProjectStep[]
  bookmarks      Bookmark[]

  @@unique([techId, slug])
}

model ProjectStep {
  id          String  @id @default(uuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  content     String
  codeSnippet String?
  order       Int
}

model CommonError {
  id           String   @id @default(uuid())
  techId       String
  tech         Tech     @relation(fields: [techId], references: [id], onDelete: Cascade)
  errorMessage String
  cause        String
  solution     String
  codeSnippet  String?
  tags         String[]
  order        Int      @default(0)
}

model Tool {
  id           String  @id @default(uuid())
  techId       String
  tech         Tech    @relation(fields: [techId], references: [id], onDelete: Cascade)
  name         String
  description  String
  purpose      String
  whyUseIt     String
  alternatives String
  bestFor      String
  docsUrl      String?
  order        Int     @default(0)
}

model Challenge {
  id           String                @id @default(uuid())
  slug         String                @unique
  title        String
  description  String
  techId       String
  tech         Tech                  @relation(fields: [techId], references: [id], onDelete: Cascade)
  techName     String
  level        Level                 @default(BEGINNER)
  prize        String
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean               @default(true)
  participants Int                   @default(0)
  submissions  ChallengeSubmission[]
}

model ChallengeSubmission {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  author      String
  avatarColor String
  repoUrl     String
  demoUrl     String?
  blurb       String
  votes       Int       @default(0)
  createdAt   DateTime  @default(now())
}

// --- Users & auth (NextAuth.js) — for the upcoming write/auth pass ---------

model User {
  id           String                @id @default(uuid())
  email        String                @unique
  name         String?
  password     String?
  image        String?
  role         UserRole              @default(USER)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  accounts     Account[]
  sessions     Session[]
  progress     UserProgress[]
  bookmarks    Bookmark[]
  certificates Certificate[]
  submissions  ChallengeSubmission[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId   String?
  roadmap     Roadmap?     @relation(fields: [roadmapId], references: [id])
  stepId      String?
  step        RoadmapStep? @relation(fields: [stepId], references: [id])
  isCompleted Boolean      @default(false)
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  @@unique([userId, stepId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId String?
  roadmap   Roadmap? @relation(fields: [roadmapId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}

model Certificate {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  techId   String
  tech     Tech     @relation(fields: [techId], references: [id])
  issuedAt DateTime @default(now())
  isPaid   Boolean  @default(false)
}
