# Copy to `.env` and fill in.
#
# OPTION A — Local Prisma Postgres (no Docker, no account):
#   npx prisma dev -d -n devpath
#   npx prisma dev ls          # copy the DATABASE_URL it prints
#
# OPTION B — Neon / hosted Postgres:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
#
# OPTION C — Production MySQL (per the original spec): change the datasource
#   provider in prisma/schema.prisma to "mysql" and use a mysql:// URL.
#
# If DATABASE_URL is unset, the app falls back to bundled content so it still runs.
DATABASE_URL=""

# NextAuth.js (for a later auth pass)
# NEXTAUTH_SECRET=""        # generate: openssl rand -base64 32
# NEXTAUTH_URL="http://localhost:3000"
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
