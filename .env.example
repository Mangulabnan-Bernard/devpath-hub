# Copy to `.env` and fill in.
#
# OPTION A — Local Prisma Postgres (no Docker, no account):
#   npx prisma dev -d -n devpath
#   npx prisma dev ls          # copy the DATABASE_URL it prints
#
# OPTION B — Neon / hosted Postgres (use sslmode=verify-full; with the pg driver
#   plain `require` prints a deprecation warning):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"
#
# OPTION C — Production MySQL (per the original spec): change the datasource
#   provider in prisma/schema.prisma to "mysql" and use a mysql:// URL.
#
# If DATABASE_URL is unset, the app falls back to bundled content so it still runs.
DATABASE_URL=""

# Auth.js (NextAuth v5) — required for login/persistence
AUTH_SECRET=""              # generate: npx auth secret   (or: openssl rand -base64 32)

# Optional OAuth providers (email/password works without these).
# Add the credentials and the buttons light up automatically.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
